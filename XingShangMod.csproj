<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <Version>2.2.0</Version>
    <AssemblyName>XingShangMod</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <RootNamespace>XingShangMod</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GameRoot Condition="'$(GameRoot)' == ''">C:\allsoft\steam\steamapps\common\LegendOfMortal</GameRoot>
    <ManagedPath Condition="'$(ManagedPath)' == ''">$(GameRoot)\Mortal_Data\Managed</ManagedPath>
    <BepInExCorePath Condition="'$(BepInExCorePath)' == ''">$(GameRoot)\BepInEx\core</BepInExCorePath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="src/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="BepInEx.Core">
      <HintPath>$(BepInExCorePath)\BepInEx.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx.Unity.Mono">
      <HintPath>$(BepInExCorePath)\BepInEx.Unity.Mono.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExCorePath)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Mortal.Core">
      <HintPath>$(ManagedPath)\Mortal.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Mortal.Free">
      <HintPath>$(ManagedPath)\Mortal.Free.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Mortal.Story">
      <HintPath>$(ManagedPath)\Mortal.Story.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
